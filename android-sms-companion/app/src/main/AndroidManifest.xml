<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="One SMS Sync" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <receiver android:name=".BankSmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500"><action android:name="android.provider.Telephony.SMS_RECEIVED"/></intent-filter>
        </receiver>
    </application>
</manifest>
