{
  "name": "One",
  "short_name": "One",
  "description": "Your personal assistant",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8fc",
  "theme_color": "#4169e1",
  "icons": [
    {
      "src": "icons/student-brain.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick note",
      "short_name": "Note",
      "description": "Capture a note in One",
      "url": "./?quick-note=1",
      "icons": [
        {
          "src": "icons/student-brain.svg",
          "sizes": "any"
        }
      ]
    },
    {
      "name": "Udhaar tracker",
      "short_name": "Udhaar",
      "description": "Open your loan and repayment tracker",
      "url": "./?open=loans",
      "icons": [
        {
          "src": "icons/student-brain.svg",
          "sizes": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_files",
          "accept": [
            "application/pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
